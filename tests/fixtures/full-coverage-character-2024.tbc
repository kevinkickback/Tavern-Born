  "details": {
    "playerName": "PDF Regression Tester",
    "gender": "Woman",
    "alignment": "Neutral Good",
    "faith": "Mystra",
    "lifestyle": "Aristocratic",
    "personalityTraits": "I collect obscure facts and answer every question with another question.",
    "personality": "Curious, patient, and unnervingly prepared.",
    "ideals": "Knowledge must be preserved and shared responsibly.",
    "bonds": "My missing mentor left a cipher only I can solve.",
    "flaws": "I cannot resist a sealed archive or forbidden library.",
    "goals": "Decode the Astral Index and reconcile three rival magical traditions.",
    "fears": "Forgetting the names of those who made the journey possible.",
    "age": 142,
    "height": "5 ft. 8 in.",
    "weight": "125 lb.",
    "eyes": "Violet",
    "skin": "Bronze",
    "hair": "Black with a silver streak",
    "distinguishingMarks": "A constellation-shaped scar across the left palm.",
    "physicalDescription": "A poised high elf scholar carrying too many annotated books.",
    "appearance": "Ink-stained fingers, violet eyes, travel-worn half plate, and midnight-blue robes.",
    "clothingStyle": "Layered scholar's robes worn over practical armor.",
    "mannerisms": "Counts doorways and taps a quill against her thumb while thinking.",
    "faction": "The Harpers",
    "rank": "Watcher",
    "factionNotes": "Maintains a covert archive and exchanges coded reports at each new moon.",
    "patron": "Archmage Ilyra Voss",
    "patronDetails": "A vanished mentor whose astral correspondence continues to arrive.",
    "nemesis": "Magister Corven Ash, curator of the sealed stacks.",
    "allies": [
      {
        "id": "ally-ilyra",
        "name": "Ilyra Voss",
        "relationship": "Missing mentor",
        "description": "An archmage who communicates through impossible star maps."
      },
      {
        "id": "ally-brom",
        "name": "Brom Ironleaf",
        "relationship": "Former adventuring companion",
        "description": "A dwarven cartographer with contacts in every major port."
      },
      {
        "id": "ally-mara",
        "name": "Sister Mara",
        "relationship": "Temple ally",
        "description": "A healer who safeguards Seraphina's research copies."
      }
    ],
    "origin": "Raised in a remote elven observatory above the Moonsea.",
    "family": "The Manypaths are mapmakers, translators, and keepers of disputed histories.",
    "definingMoment": "Survived the collapse of the Glass Library and recovered its living index.",
    "lifeEvents": "Apprenticed as a wizard, served with a mercenary company, then took vows at a temple of knowledge.",
    "backstory": "Seraphina followed a map written in starlight through ruined academies, border wars, and divine archives. Each class represents a distinct chapter of that journey.",
    "organizationSelectionKey": "",
    "organizationCustomName": "",
    "organizationCustomDescription": "",
    "organizationCustomImage": "",
    "organizationCustomGradient": "linear-gradient(135deg, #312e81, #0f766e)"
  },
