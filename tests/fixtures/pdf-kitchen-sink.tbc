  "features": [
    {
      "id": "feature-darkvision",
      "name": "Darkvision",
      "source": "PHB",
      "description": "Accustomed to twilight forests and the night sky, you can see in dim light within 60 feet as though it were bright light.",
      "level": 1
    },
    {
      "id": "feature-fey-ancestry",
      "name": "Fey Ancestry",
      "source": "PHB",
      "description": "You have advantage on saving throws against being charmed, and magic cannot put you to sleep.",
      "level": 2
    },
    {
      "id": "feature-trance",
      "name": "Trance",
      "source": "PHB",
      "description": "Elves meditate deeply for four hours instead of sleeping.",
      "level": 3
    },
    {
      "id": "feature-elf-weapon-training",
      "name": "Elf Weapon Training",
      "source": "PHB",
      "description": "You have proficiency with longswords, shortswords, shortbows, and longbows.",
      "level": 4
    },
    {
      "id": "feature-researcher",
      "name": "Researcher",
      "source": "PHB",
      "description": "When you do not know a piece of lore, you often know where and from whom you can obtain it.",
      "level": 5
    },
    {
      "id": "feature-wizard-spellcasting",
      "name": "Wizard Spellcasting",
      "source": "PHB",
      "description": "You prepare wizard spells from a spellbook using Intelligence.",
      "level": 6
    },
    {
      "id": "feature-arcane-recovery",
      "name": "Arcane Recovery",
      "source": "PHB",
      "description": "Once per day after a short rest, recover expended spell slots based on wizard level.",
      "level": 7
    },
    {
      "id": "feature-sculpt-spells",
      "name": "Sculpt Spells",
      "source": "PHB",
      "description": "Create pockets of relative safety within evocation spells that affect other creatures.",
      "level": 8
    },
    {
      "id": "feature-empowered-evocation",
      "name": "Empowered Evocation",
      "source": "PHB",
      "description": "Add your Intelligence modifier to one damage roll of a wizard evocation spell.",
      "level": 9
    },
    {
      "id": "feature-second-wind",
      "name": "Second Wind",
      "source": "PHB",
      "description": "Use a bonus action to regain hit points once per short or long rest.",
      "level": 10
    },
    {
      "id": "feature-action-surge",
      "name": "Action Surge",
      "source": "PHB",
      "description": "Take one additional action on your turn once per short or long rest.",
      "level": 1
    },
    {
      "id": "feature-combat-superiority",
      "name": "Combat Superiority",
      "source": "PHB",
      "description": "Use superiority dice to fuel maneuvers such as Precision Attack and Riposte.",
      "level": 2
    },
    {
      "id": "feature-extra-attack",
      "name": "Extra Attack",
      "source": "PHB",
      "description": "Attack twice whenever you take the Attack action.",
      "level": 3
    },
    {
      "id": "feature-cleric-spellcasting",
      "name": "Cleric Spellcasting",
      "source": "PHB",
      "description": "Prepare cleric spells using Wisdom and cast rituals when appropriate.",
      "level": 4
    },
    {
      "id": "feature-channel-divinity",
      "name": "Channel Divinity",
      "source": "PHB",
      "description": "Channel divine energy to Turn Undead or use a domain option.",
      "level": 5
    },
    {
      "id": "feature-disciple-life",
      "name": "Disciple of Life",
      "source": "PHB",
      "description": "Healing spells restore additional hit points.",
      "level": 6
    },
    {
      "id": "feature-destroy-undead",
      "name": "Destroy Undead",
      "source": "PHB",
      "description": "Undead that fail against Turn Undead may be instantly destroyed.",
      "level": 7
    }
  ],
