      "entries": [
        "Thieves' cant, a secret mix of dialect, jargon, and code that allows you to hide messages in seemingly normal conversation. Only another creature that knows thieves' cant understands such messages. It takes four times longer to convey such a message than it does to speak the same idea plainly. In addition, you understand a set of secret signs and symbols used to convey short, simple messages."
      ],
      "name": "Thieves' Cant",
      "source": "PHB",
      "srd": true,
      "type": "secret",
      "typicalSpeakers": [
        "{@creature assassin||assassins}",
        "{@class rogue||rogues}"
