{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx!",
    "electron/main.ts!",
    "electron/catalogWorker.ts!",
    "electron/preload.ts!",
    "public/theme-init.js!",
    "scripts/**/*.{js,mjs,ts}",
    "tests/**/*.{test,spec}.{ts,tsx}",
    "config/vite.e2e.ts",
    "config/vitest.coverage-shard.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "src/**/*.css!",
    "electron/**/*.ts!",
    "public/**/*.js!",
    "scripts/**/*.{js,mjs,ts}",
    "tests/**/*.{ts,tsx}",
    "*.config.ts",
    "config/**/*.ts"
  ]
}
